---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { miembros, actividades, ejes } from "../../data/miembros";

export function getStaticPaths() {
  const slugify = (str: string) => str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/\s+/g, '-');
  
  return miembros.map(miembro => ({
    params: { slug: slugify(miembro.nombre) },
    props: { miembro },
  }));
}

const { miembro } = Astro.props;

// Enrich participations with full activity data & order (assuming newest first based on original prompt implicit timeline or just keeping array order)
const enrichedParticipaciones = miembro.participaciones.map(p => {
  const act = actividades.find(a => a.id === p.actividadId);
  return { ...p, act };
}).filter(p => p.act);
---

<BaseLayout 
  title={`${miembro.nombre} - Comunidad SOCIDAIN`}
  description={`Perfil de participación de ${miembro.nombre} en SOCIDAIN`}
>
  <div class="min-h-screen bg-gray-50 py-16">
    <div class="container mx-auto px-4 max-w-3xl">
      <!-- Header -->
      <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-12 mb-8">
        <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-2">{miembro.nombre}</h1>
        <p class="text-gray-500 text-lg font-medium">
          {enrichedParticipaciones.length} actividad{enrichedParticipaciones.length !== 1 ? 'es' : ''} participadas
        </p>
      </div>

      <!-- Timeline -->
      <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-12 mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-8 border-b border-gray-100 pb-4">Historial de Participación</h2>
        
        {enrichedParticipaciones.length > 0 ? (
          <div class="space-y-8 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gray-200">
            {enrichedParticipaciones.map((item, index) => {
              const act = item.act!;
              const ejeObj = ejes[act.eje as keyof typeof ejes];
              
              return (
                <div class="relative flex items-start justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                  <!-- Timeline dot -->
                  <div 
                    class={`flex items-center justify-center w-10 h-10 rounded-full border-4 border-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10`}
                    style={`background-color: ${ejeObj?.color || '#ccc'}`}
                  ></div>
                  
                  <!-- Content Box -->
                  <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white border border-gray-100 p-5 rounded-2xl shadow-sm">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-3 gap-2">
                      <span class={`text-xs font-semibold px-2 py-1 rounded-full border bg-transparent inline-block w-fit ${ejeObj?.text} ${ejeObj?.border}`}>
                        {ejeObj?.label}
                      </span>
                      <time class="text-xs text-gray-400 font-medium whitespace-nowrap">{act.fecha}</time>
                    </div>
                    
                    <a href={`/events/${act.eventSlug}`} class="block group/link mb-2 md:text-lg font-bold text-gray-900 hover:text-[#900033] transition-colors">
                      {act.nombre}
                    </a>
                    
                    <p class="text-sm text-gray-600 leading-relaxed">
                      {item.aporte}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="py-8 text-center text-gray-500">No hay registros de participación.</div>
        )}
      </div>

      <!-- Observaciones (Optional, low visual footprint) -->
      {miembro.observaciones && miembro.observaciones.length > 0 && (
        <div class="mt-12 px-4 md:px-12">
          <h3 class="text-sm font-medium text-gray-400 mb-4 tracking-wider uppercase">Observaciones</h3>
          <ul class="space-y-4">
            {miembro.observaciones.map(obs => (
              <li class="pl-4 border-l-2 border-gray-200 text-sm text-gray-500">
                <span class="block text-xs font-semibold mb-1 text-gray-400">{obs.fecha}</span>
                <span class="leading-relaxed">{obs.descripcion}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

    </div>
  </div>
</BaseLayout>
