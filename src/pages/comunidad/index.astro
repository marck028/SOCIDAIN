---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import { miembros, actividades, ejes } from "../../data/miembros";

// Add slug utility explicitly inline to ensure isolation
const slugify = (str: string) => {
  return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/\s+/g, '-');
};

const getUniqueEjes = (participaciones: any[]) => {
  const participadosIds = participaciones.map(p => {
    const act = actividades.find(a => a.id === p.actividadId);
    return act ? act.eje : null;
  }).filter(Boolean);
  
  return [...new Set(participadosIds)];
};
---

<BaseLayout 
  title="Comunidad - SOCIDAIN" 
  description="Registro de participación de los integrantes de SOCIDAIN en actividades de la sociedad."
>
  <PageHeader 
    title="Comunidad" 
    subtitle="Registro de participación de los integrantes de SOCIDAIN en actividades de la sociedad."
    backgroundImage={null}
  />

  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {miembros.map(miembro => {
          const uniqueEjes = getUniqueEjes(miembro.participaciones);
          return (
            <a 
              href={`/comunidad/${slugify(miembro.nombre)}`} 
              class="group bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-300 p-6 flex flex-col h-full"
            >
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-[#900033] transition-colors mb-3">
                {miembro.nombre}
              </h3>
              
              <div class="flex flex-wrap gap-2 mb-4">
                {uniqueEjes.map((ejeId) => {
                  const ejeObj = ejes[ejeId as keyof typeof ejes];
                  if (!ejeObj) return null;
                  return (
                    <span 
                      class={`text-xs font-semibold px-2 py-1 rounded-full border bg-transparent ${ejeObj.text} ${ejeObj.border}`}
                    >
                      {ejeObj.label}
                    </span>
                  );
                })}
              </div>
              
              <div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-between">
                <span class="text-sm text-gray-500 font-medium">
                  {miembro.participaciones.length} actividad{miembro.participaciones.length !== 1 ? 'es' : ''}
                </span>
                <span class="text-[#900033] text-sm font-bold opacity-0 group-hover:opacity-100 transform translate-x-[-10px] group-hover:translate-x-0 transition-all">
                  Ver perfil →
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
